{
    "name": "Homelab Catalog — Linux",
    "image": "mcr.microsoft.com/devcontainers/base:bookworm",

    "features": {
        "ghcr.io/devcontainers/features/node:1": {
            "version": "24"
        },
        "ghcr.io/devcontainers/features/powershell:1": {},
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
    },

    "mounts": [
        "source=homelab-catalog-sops,target=/home/vscode/.config/sops,type=volume",
        "source=${localEnv:HOME}/snap/bw/current/Bitwarden CLI,target=/home/vscode/.config/Bitwarden CLI,type=bind,consistency=cached"
    ],

    "postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.config && sudo chmod +x scripts/install-dependencies.sh && bash scripts/install-dependencies.sh",

    "postStartCommand": "bash scripts/update-dotfiles.sh",

    "remoteEnv": {
        "BW_SERVER_URL": "${localEnv:BW_SERVER_URL}",
        "NO_AUTOSTART": "1"
    },

    "containerEnv": {
        "SOPS_AGE_KEY_FILE": "/home/vscode/.config/sops/age/keys.txt",
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
        "TZ": "${localEnv:TZ:Europe/Berlin}",
        "DEVCONTAINER": "1"
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-azuretools.vscode-docker",
                "timonwong.shellcheck",
                "foxundermoon.shell-format"
            ],
            "settings": {
                "files.associations": {
                    "compose*.yml": "dockercompose"
                },
                "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font Mono', monospace"
            }
        }
    }
}
