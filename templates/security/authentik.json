{
  "type": 3,
  "title": "Authentik",
  "description": "Identity provider with SSO, OIDC, SAML, and LDAP support",
  "logo": "https://raw.githubusercontent.com/goauthentik/authentik/main/web/icons/icon.png",
  "categories": ["Security"],
  "repository": {
    "url": "https://github.com/st0o0/homelab-catalog",
    "stackfile": "stacks/authentik/compose.yml"
  },
  "env": [
    { "name": "AUTHENTIK_SECRET_KEY", "label": "Secret Key", "default": "" },
    { "name": "AUTHENTIK_POSTGRESQL__PASSWORD", "label": "PostgreSQL Password", "default": "" },
    { "name": "AUTHENTIK_POSTGRESQL__HOST", "label": "PostgreSQL Host", "default": "authentik-db" },
    { "name": "AUTHENTIK_POSTGRESQL__USER", "label": "PostgreSQL User", "default": "authentik" },
    { "name": "AUTHENTIK_POSTGRESQL__NAME", "label": "PostgreSQL Database", "default": "authentik" },
    { "name": "AUTHENTIK_PORT_HTTP", "label": "HTTP Port", "default": "9000" },
    { "name": "AUTHENTIK_PORT_HTTPS", "label": "HTTPS Port", "default": "9443" },
    { "name": "TZ", "label": "Timezone", "default": "Europe/Berlin" }
  ],
  "note": "Deploys 2 containers: authentik-server (HTTP/HTTPS) and authentik-worker. Requires an external PostgreSQL database. Generate AUTHENTIK_SECRET_KEY with: openssl rand -hex 32"
}
