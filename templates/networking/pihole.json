{
  "type": 3,
  "title": "Pi-hole",
  "description": "DNS sinkhole for network-wide ad blocking with Nebula-Sync for multi-instance replication",
  "categories": ["Networking", "DNS"],
  "repository": {
    "url": "https://github.com/st0o0/homelab-catalog",
    "stackfile": "stacks/pihole/compose.yml"
  },
  "env": [
    { "name": "PIHOLE_PASSWORD", "label": "Pi-hole Admin Password", "default": "" },
    { "name": "PIHOLE_DNS_PORT", "label": "DNS Port (TCP)", "default": "53" },
    { "name": "PIHOLE_WEB_PORT", "label": "Web UI Port", "default": "1000" },
    { "name": "NEBULA_PRIMARY", "label": "Nebula-Sync Primary Instance URL (optional)", "default": "" },
    { "name": "NEBULA_REPLICAS", "label": "Nebula-Sync Replica URLs (optional)", "default": "" },
    { "name": "NEBULA_CRON", "label": "Nebula-Sync Schedule", "default": "0 23 * * *" },
    { "name": "TZ", "label": "Timezone", "default": "Europe/Berlin" }
  ],
  "note": "Deploys 2 containers: pihole (NET_ADMIN, DNS on TCP+UDP port 53) and nebula-sync (optional multi-instance sync). Configure Nebula-Sync PRIMARY and REPLICAS only when running multiple Pi-hole instances."
}
