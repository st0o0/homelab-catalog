{
  "type": 3,
  "title": "PostgreSQL",
  "description": "Shared PostgreSQL 17 database with CloudBeaver web-based database manager",
  "categories": ["Database"],
  "repository": {
    "url": "https://github.com/st0o0/homelab-catalog",
    "stackfile": "stacks/postgres/compose.yml"
  },
  "env": [
    { "name": "POSTGRES_PASSWORD", "label": "PostgreSQL Password", "default": "" },
    { "name": "POSTGRES_USER", "label": "PostgreSQL User", "default": "postgres" },
    { "name": "POSTGRES_DB", "label": "Default Database", "default": "postgres" },
    { "name": "POSTGRES_PORT", "label": "PostgreSQL Port", "default": "5432" },
    { "name": "POSTGRES_BIND_IP", "label": "Bind IP", "default": "127.0.0.1" },
    { "name": "CLOUDBEAVER_PORT", "label": "CloudBeaver Port", "default": "8978" },
    { "name": "TZ", "label": "Timezone", "default": "Europe/Berlin" }
  ],
  "note": "Deploys 2 containers: postgres (SCRAM-SHA-256 auth, bound to 127.0.0.1 by default) and cloudbeaver (web database manager). Used as shared database for Authentik, Mealie, Grafana, and other services."
}
