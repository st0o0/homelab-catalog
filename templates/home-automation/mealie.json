{
  "type": 3,
  "title": "Mealie",
  "description": "Self-hosted recipe manager with meal planning, OIDC login, and PostgreSQL backend",
  "categories": ["Home Automation"],
  "repository": {
    "url": "https://github.com/st0o0/homelab-catalog",
    "stackfile": "stacks/mealie/compose.yml"
  },
  "env": [
    { "name": "MEALIE_PORT", "label": "Web UI Port", "default": "9925" },
    { "name": "BASE_URL", "label": "Base URL (for links and OIDC redirect)", "default": "" },
    { "name": "POSTGRES_PASSWORD", "label": "PostgreSQL Password", "default": "" },
    { "name": "POSTGRES_SERVER", "label": "PostgreSQL Host", "default": "" },
    { "name": "POSTGRES_USER", "label": "PostgreSQL User", "default": "mealie" },
    { "name": "POSTGRES_PORT", "label": "PostgreSQL Port", "default": "5432" },
    { "name": "POSTGRES_DB", "label": "PostgreSQL Database", "default": "mealie" },
    { "name": "OIDC_CONFIGURATION_URL", "label": "OIDC Discovery URL (optional)", "default": "" },
    { "name": "OIDC_CLIENT_ID", "label": "OIDC Client ID (optional)", "default": "" },
    { "name": "OIDC_CLIENT_SECRET", "label": "OIDC Client Secret (optional)", "default": "" },
    { "name": "PUID", "label": "User ID", "default": "1000" },
    { "name": "PGID", "label": "Group ID", "default": "1000" },
    { "name": "TZ", "label": "Timezone", "default": "Europe/Berlin" }
  ],
  "note": "Deploys 1 container: mealie. Requires an external PostgreSQL database. OIDC is pre-configured for Authentik but works with any provider. Password login and signups are disabled by default when OIDC is enabled."
}
