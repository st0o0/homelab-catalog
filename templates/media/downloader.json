{
  "type": 3,
  "title": "Downloader",
  "description": "SABnzbd behind Gluetun VPN with WireGuard for secure Usenet downloading",
  "categories": ["Media"],
  "repository": {
    "url": "https://github.com/st0o0/homelab-catalog",
    "stackfile": "stacks/downloader/compose.yml"
  },
  "env": [
    { "name": "VPN_SERVICE_PROVIDER", "label": "VPN Provider", "default": "airvpn" },
    { "name": "VPN_TYPE", "label": "VPN Type", "default": "wireguard" },
    { "name": "WIREGUARD_PRIVATE_KEY", "label": "WireGuard Private Key", "default": "" },
    { "name": "WIREGUARD_ADDRESSES", "label": "WireGuard Addresses", "default": "" },
    { "name": "WIREGUARD_PRESHARED_KEY", "label": "WireGuard Preshared Key (optional)", "default": "" },
    { "name": "SERVER_CITIES", "label": "VPN Server City", "default": "Alblasserdam" },
    { "name": "GLUETUN_PORT", "label": "Gluetun Control Port", "default": "8079" },
    { "name": "SABNZBD_PORT", "label": "SABnzbd Web UI Port", "default": "8080" },
    { "name": "PUID", "label": "User ID", "default": "1000" },
    { "name": "PGID", "label": "Group ID", "default": "1000" },
    { "name": "TZ", "label": "Timezone", "default": "Europe/Berlin" }
  ],
  "note": "Deploys 2 containers: gluetun (VPN, NET_ADMIN, /dev/net/tun) and sabnzbd (network_mode: service:gluetun). Requires the external media-net network and a CIFS volume for completed downloads."
}
