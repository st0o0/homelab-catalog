# Required
TOKEN=changeme

# Edge mode (leave DOCKHAND_SERVER_URL empty for direct mode)
DOCKHAND_SERVER_URL=changeme

# Optional
# HAWSER_CONTAINER_NAME=hawser
# AGENT_NAME=
# HEARTBEAT_INTERVAL=30
# DOCKER_SOCKET=/var/run/docker.sock
# STACKS_PATH=hawser-stacks
# TZ=Europe/Berlin

# Direct mode: copy compose.override.direct.yaml -> compose.override.yaml
# HAWSER_PORT=2376

# Bifrost mode: copy compose.override.bifrost.yaml -> compose.override.yaml
# Requires a running Bifrost container (deploy stacks/bifrost first)
# BIFROST_CONTAINER_NAME=bifrost
